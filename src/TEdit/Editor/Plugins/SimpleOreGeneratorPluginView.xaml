<ui:FluentWindow x:Class="TEdit.Editor.Plugins.SimpleOreGeneratorPluginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:TEdit.Properties"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:view="clr-namespace:TEdit.View"
        Title="{x:Static p:Language.plugin_ore_title}"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Icon="/TEdit;component/Images/tedit.ico"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ControlBackgroundBrush}"
        WindowBackdropType="Mica"
        MinWidth="290" MinHeight="420"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{x:Static p:Language.plugin_ore_title}" Grid.Row="0"
                     Padding="0" Margin="0"
                     FontSize="12" Height="32"
                     ShowMinimize="False"
                     ShowMaximize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border Padding="10,4,10,10">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Tier 1 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_1}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier1BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="1" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="CopperRadioButton" Content="{x:Static p:Language.plugin_ore_copper}" TabIndex="2" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="TinRadioButton" Content="{x:Static p:Language.plugin_ore_tin}" TabIndex="3" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier1NARadioButton" Content="N/A" TabIndex="4" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 2 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_2}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier2BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="5" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="IronRadioButton" Content="{x:Static p:Language.plugin_ore_iron}" TabIndex="6" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="LeadRadioButton" Content="{x:Static p:Language.plugin_ore_lead}" TabIndex="7" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier2NARadioButton" Content="N/A" TabIndex="8" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 3 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_3}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier3BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="9" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="SilverRadioButton" Content="{x:Static p:Language.plugin_ore_silver}" TabIndex="10" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="TungstenRadioButton" Content="{x:Static p:Language.plugin_ore_tungsten}" TabIndex="11" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier3NARadioButton" Content="N/A" TabIndex="12" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 4 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_4}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier4BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="13" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="GoldRadioButton" Content="{x:Static p:Language.plugin_ore_gold}" TabIndex="14" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="PlatinumRadioButton" Content="{x:Static p:Language.plugin_ore_platinum}" TabIndex="15" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier4NARadioButton" Content="N/A" TabIndex="16" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 5 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_5}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="MeteoriteCheckbox" Content="{x:Static p:Language.plugin_ore_meteorite}" TabIndex="17" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 6 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_6}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier6BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="18" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="DemoniteRadioButton" Content="{x:Static p:Language.plugin_ore_demonite}" TabIndex="19" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="CrimtaneRadioButton" Content="{x:Static p:Language.plugin_ore_crimtane}" TabIndex="20" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier6NARadioButton" Content="N/A" TabIndex="21" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 7 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_7}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ObsidianCheckbox" Content="{x:Static p:Language.plugin_ore_obsidian}" TabIndex="22" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 8 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_8}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="HellstoneCheckbox" Content="{x:Static p:Language.plugin_ore_hellstone}" TabIndex="23" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 9 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_9}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier9BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="24" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="CobaltRadioButton" Content="{x:Static p:Language.plugin_ore_cobalt}" TabIndex="25" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="PalladiumRadioButton" Content="{x:Static p:Language.plugin_ore_palladium}" TabIndex="26" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier9NARadioButton" Content="N/A" TabIndex="27" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 10 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_10}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier10BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="28" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="MythrilRadioButton" Content="{x:Static p:Language.plugin_ore_mythril}" TabIndex="29" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="OrichalcumRadioButton" Content="{x:Static p:Language.plugin_ore_orichalcum}" TabIndex="30" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier10NARadioButton" Content="N/A" TabIndex="31" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 11 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_11}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="Tier11BothRadioButton" Content="{x:Static p:Language.common_both}" TabIndex="32" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="AdamantiteRadioButton" Content="{x:Static p:Language.plugin_ore_adamantite}" TabIndex="33" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="TitaniumRadioButton" Content="{x:Static p:Language.plugin_ore_titanium}" TabIndex="34" IsChecked="False" Margin="0,0,12,0"/>
                            <RadioButton x:Name="Tier11NARadioButton" Content="N/A" TabIndex="35" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 12 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_12}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChlorophyteCheckbox" Content="{x:Static p:Language.plugin_ore_chlorophyte}" TabIndex="36" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tier 13 Ores -->
                    <GroupBox Margin="0,0,0,2">
                        <GroupBox.Header>
                            <TextBlock Text="{x:Static p:Language.plugin_ore_tier_13}" Foreground="White"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="LuminiteCheckbox" Content="{x:Static p:Language.plugin_ore_luminite}" TabIndex="37" IsChecked="False"/>
                        </StackPanel>
                    </GroupBox>

                    <Grid Height="3"/>
                    
                    <!-- Generation Options -->
                    <CheckBox x:Name="IncludeAshCheckBox" Content="{x:Static p:Language.plugin_ore_convert_ash}" HorizontalAlignment="Center" IsChecked="False" TabIndex="38"/>
                    <Grid Height="3"/>
                    <CheckBox x:Name="OnlyUseSelectionCheckBox" Content="{x:Static p:Language.plugin_ore_only_selection}" HorizontalAlignment="Center" TabIndex="39"/>
                    <Grid Height="3"/>
                    <CheckBox x:Name="UndoCheckBox" Content="{x:Static p:Language.plugin_ore_enable_undo}" HorizontalAlignment="Center" IsChecked="False" TabIndex="40"/>

                    <Grid Height="3"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12,8,12,14" Background="{DynamicResource ControlBackgroundBrush}">
            <Grid Width="264" HorizontalAlignment="Center">
                <Button Content="{x:Static p:Language.common_cancel}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="CancelButtonClick" Height="26" MinWidth="80" TabIndex="41"/>
                <Button Content="{x:Static p:Language.common_generate}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OkButtonClick" Height="26" MinWidth="80" TabIndex="42"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
